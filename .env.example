# Optional on Vercel: its production URL is detected automatically.
# Set this when a custom production domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Required for real inquiry delivery through Resend. Do not prefix these with
# NEXT_PUBLIC_ and do not commit real values.
RESEND_API_KEY=re_example
# Use a sender address from a domain verified in Resend, for example:
RESEND_FROM_EMAIL=Hidriving Website <inquiries@example.com>
# Optional. Defaults to the confirmed Hidriving inquiry mailbox when omitted.
INQUIRY_TO_EMAIL=ciararice775239@gmail.com
